#!/bin/bash
# Run the unit tests. Swift Testing needs Xcode's toolchain; the command line tools alone lack its macros.
set -euo pipefail
cd "$(dirname "$0")/.."
if [ -z "${DEVELOPER_DIR:-}" ] && [ -d /Applications/Xcode.app/Contents/Developer ]; then
  export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
fi
exec swift test "$@"
