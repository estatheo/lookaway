#!/bin/bash
# Build build/lookaway.app (release by default; CONFIG=debug for a debug build).
#
# Signing: camera permission (TCC) is tied to the app's code-signing identity. A plain
# ad-hoc signature changes with every rebuild and would re-prompt each time, so by
# default we sign ad-hoc with a fixed designated requirement ("identifier <bundle id>"),
# which stays the same across rebuilds. Set LOOKAWAY_SIGN_IDENTITY to a local
# certificate name to sign with that instead.
set -euo pipefail
cd "$(dirname "$0")/.."

# swift-testing and a full SDK need Xcode's toolchain, not just the command line tools.
if [ -z "${DEVELOPER_DIR:-}" ] && [ -d /Applications/Xcode.app/Contents/Developer ]; then
  export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
fi

CONFIG="${CONFIG:-release}"
BUNDLE_ID="local.gizmos.lookaway"
APP="build/lookaway.app"

# UNIVERSAL=1 builds for Apple silicon and Intel in one binary (for a release download).
ARCH_FLAGS=()
if [ "${UNIVERSAL:-0}" = "1" ]; then ARCH_FLAGS=(--arch arm64 --arch x86_64); fi
swift build -c "$CONFIG" "${ARCH_FLAGS[@]+"${ARCH_FLAGS[@]}"}"
BIN="$(swift build -c "$CONFIG" "${ARCH_FLAGS[@]+"${ARCH_FLAGS[@]}"}" --show-bin-path)/lookaway"

rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cp "$BIN" "$APP/Contents/MacOS/lookaway"
cp Resources/Info.plist "$APP/Contents/Info.plist"
cp Resources/AppIcon.icns "$APP/Contents/Resources/AppIcon.icns"
cp Resources/default-blocked.mp4 "$APP/Contents/Resources/default-blocked.mp4"

IDENTITY="${LOOKAWAY_SIGN_IDENTITY:--}"
if [ "$IDENTITY" = "-" ]; then
  codesign --force --sign - --identifier "$BUNDLE_ID" \
    --requirements "=designated => identifier \"$BUNDLE_ID\"" "$APP"
else
  codesign --force --sign "$IDENTITY" --identifier "$BUNDLE_ID" "$APP"
fi
codesign --verify --strict "$APP"

echo "Built $APP"
codesign -d -r- "$APP" 2>&1 | grep designated || true
